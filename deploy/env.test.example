# The .env for test.webis.ro: copied to the server as .env (never committed),
# the blanks filled in there. See deploy/README.md.

APP_NAME=Webis
# Not "production": the whole site is noindex (Support\Seo\Indexing), and
# stays so whatever its pages say.
APP_ENV=staging
# php artisan key:generate --show (one of its own, not the local one)
APP_KEY=
APP_DEBUG=false
APP_URL=https://test.webis.ro

APP_LOCALE=ro
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ro_RO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# cPanel › MySQL Databases: the names carry the account's prefix
# (cpuser_webistest).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# MariaDB 11.4 has no utf8mb4_0900_ai_ci of its own (MySQL 8's).
DB_COLLATION=utf8mb4_uca1400_ai_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Image conversions (covers, uploads) wait here for the cron's worker.
QUEUE_CONNECTION=database

CACHE_STORE=database

# A test site sends nothing by default: messages go to the log.
# For real mail: MAIL_MAILER=smtp, the mailbox's host (mail.webis.ro),
# port 465, scheme smtps, its address and password.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="test@webis.ro"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

SITE_LOWER_TONE=dark
