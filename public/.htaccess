<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # The bare domain to the canonical one, with www (config/site.php,
    # canonical_url): one address per page. That host only — the test site
    # and the local one are left alone.
    RewriteCond %{HTTP_HOST} ^webis\.ro$ [NC]
    RewriteRule ^ https://www.webis.ro%{REQUEST_URI} [R=301,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # No trailing-slash redirect: the app owns the canonical form, with the
    # slash (App\Http\Middleware\CanonicalTrailingSlash).

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Types the server may not know: fonts and modern images go out as what
# they are, so the cache and compression rules below can tell them apart.
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType image/webp .webp
    AddType image/avif .avif
    AddType image/svg+xml .svg
</IfModule>

# Compression: pages, styles, scripts and the like go out gzipped (the
# site's stylesheet is ~350 KB as written, ~52 KB compressed). Images and
# fonts are compressed already and are left alone.
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml application/manifest+json
    </IfModule>
</IfModule>

# Browser caching for the files the server sends itself (PHP pages set
# their own headers: they are not cached).
<IfModule mod_headers.c>
    # Images, icons and fonts — the uploads under /storage, the favicons: a
    # month. A replaced upload gets a new address (a new media folder).
    <FilesMatch "\.(avif|webp|jpe?g|png|gif|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # The build (/build/assets): every name carries a hash of its content
    # (site-CmfehY_A.css, onest-400-normal-9AYXx_QC.woff2), so a new version
    # is a new address. A year, never asked again. Last, so it wins over the
    # month above for the fonts.
    <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# PHP 8.4 on the hosting (cPanel's MultiPHP Manager, ea-php84), in its own
# words: setting a domain's version writes this block into the document
# root's .htaccess — this file, a tracked one — and a changed file stops
# cPanel from deploying. Already here and the same, it changes nothing.
# Ignored by nginx (Herd, locally).

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
