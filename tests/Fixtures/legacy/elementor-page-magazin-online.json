                    {
                        "id": "7ad2db0",
                        "elType": "widget",
                        "widgetType": "text-editor",
                        "settings": {
                            "editor": "<div class=\"elementor-element elementor-element-7fe6092 elementor-widget elementor-widget-text-editor\" data-id=\"7fe6092\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\"><div class=\"elementor-widget-container\">Oferim servicii SEO atat pentru clienti din Iasi, cat si pentru cei din restul tarii. Webis se ocupa de web design, web development &amp; SEO.</div></div>",
                            "typography_font_weight": "400",
